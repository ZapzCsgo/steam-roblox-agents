# Copy to .env and fill in ONE provider. Default is the offline scripted model.
SRA_LLM_PROVIDER=fake          # fake | google | anthropic | openai | ollama | hermes
# SRA_LLM_MODEL=gemini-2.5-flash
# With SRA_LLM_PROVIDER=hermes, calls go through the local `hermes chat` CLI:
# SRA_LLM_MODEL=openai-codex/gpt-6-sol
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
SRA_HTTP_MODE=replay           # replay (fixtures) | live | record
SRA_MAX_REVISIONS=2
SRA_CRITIC_LLM=true
